#define ZMK_POINTING_DEFAULT_SCRL_VAL 150

#include <dt-bindings/zmk/input_transform.h>
#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define MOUSE 1
#define MARK 2
#define CURSOR 3
#define FUNCTION 4
#define SCROLL 5
#define WIRELESS 6

//mouse cursol

&mmv {
    delay-ms = <20>;
    trigger-period-ms = <5>;
    time-to-max-speed-ms = <100>;
    acceleration-exponent = <2>;
};

//mouse scroll

&msc {
    delay-ms = <3>;
    trigger-period-ms = <3>;
    time-to-max-speed-ms = <100>;
    acceleration-exponent = <0>;
};

/ {
    input_processors {
        zip_wheel_scaler: zip_wheel_scaler {
            compatible = "zmk,input-processor-scaler";
            #input-processor-cells = <2>;
            type = <INPUT_EV_REL>;
            codes = <INPUT_REL_WHEEL>;
            track-remainders;
        };
    };
};

&msc_input_listener {
    speed_up {
        layers = <FUNCTION>;
        input-processors = <&zip_wheel_scaler 3 1>; //スクロールを3倍速にする
    };
};

&trackball_listener {
    scroller {
        layers = <SCROLL>;
        input-processors =
            <&zip_xy_transform INPUT_TRANSFORM_Y_INVERT>,
            //スクロール方向を逆転,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,
            <&zip_xy_to_scroll_mapper>;
    };
};

/ {
    combos {
        compatible = "zmk,combos";

        LeftClick {
            bindings = <&mkp MB1>;
            key-positions = <16 17>;
        };

        RightClick {
            bindings = <&mkp MB2>;
            key-positions = <17 18>;
        };

        k-open01 {
            bindings = <&kp ASTERISK>;
            key-positions = <3 13>;
        };

        k-close01 {
            bindings = <&kp LEFT_PARENTHESIS>;
            key-positions = <6 16>;
        };

        k-open02 {
            bindings = <&kp RIGHT_BRACKET>;
            key-positions = <13 23>;
        };

        k-close02 {
            bindings = <&kp NON_US_HASH>;
            key-positions = <16 26>;
        };

        l-enter {
            bindings = <&kp ENTER>;
            key-positions = <30 31>;
        };

        up {
            bindings = <&kp LA(UP_ARROW)>;
            key-positions = <27 28 29>;
        };

        down {
            bindings = <&kp ENTER>;
            key-positions = <39 28>;
        };

        left {
            bindings = <&kp LA(LEFT)>;
            key-positions = <27 38>;
        };

        right {
            bindings = <&kp LA(RIGHT)>;
            key-positions = <29 40>;
        };

        Sedit {
            bindings = <&MSedit>;
            key-positions = <16 17 18 36>;
        };

        cut {
            bindings = <&kp LC(X)>;
            key-positions = <6 7 8>;
        };

        ALT2 {
            bindings = <&kp LA(NUMBER_2)>;
            key-positions = <1 11>;
        };

        ALT3 {
            bindings = <&kp LA(NUMBER_3)>;
            key-positions = <2 12>;
        };

        FUN5 {
            bindings = <&kp F5>;
            key-positions = <4 14>;
        };
    };

    behaviors {
        re_kp: sensor_rotate_kp {
            compatible = "zmk,behavior-sensor-rotate-var";
            #sensor-binding-cells = <2>;
            bindings = <&kp>, <&kp>;
        };

        mouse_scrl: mouse_wheel_scrl {
            compatible = "zmk,behavior-sensor-rotate-var";
            #sensor-binding-cells = <2>;
            bindings = <&msc>, <&msc>;

            tap-ms = <20>;
        };
    };

    macros {
        MPW: M01PW {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp S &kp H &kp O &kp W &kp N2 &kp N4 &kp N5 &kp N6 &kp G &kp U &kp Y &kp ENTER>;
            label = "M01PW";
        };

        Msum: M04sum {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&kp INT_KANA &kp LANG_ZENKAKUHANKAKU &kp S &kp U &kp M &kp LPAR &kp RPAR &kp ENTER>,
                <&macro_wait_time 200>,
                <&kp LEFT>;

            label = "M04SUM";
        };

        Mroundup: M05roundup {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&kp INT_KANA &kp LANG_ZENKAKUHANKAKU &kp R &kp O &kp U &kp N &kp D &kp U &kp P &kp LPAR &kp RPAR &kp ENTER>,
                <&macro_wait_time 200>,
                <&kp LEFT>;

            label = "M05ROUNDUP";
        };

        MSedit: M06Sedit {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_wait_time 400>,
                <&kp LC(S) &kp END>,
                <&macro_wait_time 15>,
                <&kp DOT &kp E &kp D &kp I &kp T &to 7>;

            label = "M06SEDIT";
        };

        Msavetofav: Msavetofav {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&kp F4 &kp LC(A) &kp LS(D) &kp APOS &kp LA(INTERNATIONAL_3) &kp KP_NUMBER_0 &kp KP_NUMBER_2 &kp DOT &kp T &kp H &kp U &kp M &kp B &kp N &kp A &kp I &kp L &kp LA(INTERNATIONAL_3) &kp KP_NUMBER_0 &kp KP_NUMBER_1 &kp DOT &kp F &kp A &kp V &kp ENTER>,
                <&macro_wait_time 600>,
                <&kp LS(TAB) &kp LS(TAB) &kp LS(TAB) &kp LS(TAB) &kp LS(TAB) &to 6>;

            label = "MSAVETOFAV";
        };

        Msavetonotfav: Msavetonotfav {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&kp F4 &kp LC(A) &kp LS(D) &kp APOS &kp LA(INTERNATIONAL_3) &kp KP_NUMBER_0 &kp KP_NUMBER_2 &kp PERIOD &kp T &kp H &kp U &kp M &kp B &kp N &kp A &kp I &kp L &kp LA(INTERNATIONAL_3) &kp KP_NUMBER_0 &kp KP_NUMBER_2 &kp DOT &kp A &kp R &kp C &kp ENTER>,
                <&macro_wait_time 600>,
                <&macro_tap_time 200>,
                <&kp LA(S) &to 6>;

            label = "MSAVETONOTFAV";
        };

        MsetA: MsetA {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap_time 200>, <&kp LA(E) &kp A &kp A>;

            label = "MSETA";
        };

        MsetB: MsetB {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap_time 200>, <&kp LA(E) &kp B>, <&macro_press>;

            label = "MSETB";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&mt Q ESCAPE      &kp W         &kp E         &kp R  &kp T                              &kp Y  &kp U  &kp I           &kp O             &mt P BACKSPACE
&kp A             &kp S         &kp D         &kp F  &kp G                              &kp H  &kp J  &kp K           &kp L             &mt MINUS ENTER
&mt LEFT_SHIFT Z  &kp X         &kp C         &kp V  &kp B                              &kp N  &kp M  &kp COMMA       &mt DOT UP_ARROW  &kp SLASH
&mt LCTRL TAB     &kp LEFT_WIN  &kp LEFT_ALT  &none  &mo 2  &lt 4 SPACE    &lt 3 SPACE  &mo 1         &kp LEFT_ARROW  &kp DOWN          &kp RIGHT
            >;

            sensor-bindings = <&mouse_scrl SCRL_DOWN SCRL_UP>;
        };

        LAYER01 {
            bindings = <
&none           &none  &none  &none  &none                                      &kp F6                   &kp F7       &kp F8         &none   &kp DELETE
&none           &none  &none  &MPW   &none                                      &none                    &kp HOME     &kp END        &kp F9  &kp F10
&kp LEFT_SHIFT  &none  &none  &none  &none                                      &none                    &kp PAGE_UP  &kp PAGE_DOWN  &none   &none
&kp RCTRL       &none  &none  &none  &kp GRAVE  &kp INT_HENKAN    &kp LEFT_ALT  &kp LANG_ZENKAKUHANKAKU               &to 5          &none   &bootloader
            >;

            sensor-bindings = <&mouse_scrl SCRL_DOWN SCRL_UP>;
        };

        NUMBER {
            bindings = <
&kp LS(NUMBER_1)  &kp F2        &kp LG(E)     &kp LG(R)  &kp F4                                  &kp KP_ASTERISK  &kp KP_NUMBER_7  &kp KP_NUMBER_8  &kp KP_NUMBER_9  &kp BACKSPACE
&kp A             &kp S         &kp DOLLAR    &kp HASH   &kp COLON                               &kp KP_MINUS     &kp KP_NUMBER_4  &kp KP_NUMBER_5  &kp KP_NUMBER_6  &kp KP_ENTER
&kp LS(CAPS)      &kp X         &kp C         &kp V      &Msum                                   &kp KP_DIVIDE    &kp KP_NUMBER_1  &kp KP_NUMBER_2  &kp KP_NUMBER_3  &kp PERCENT
&bootloader       &kp LEFT_GUI  &kp LEFT_ALT  &none      &mo 1      &kp SPACE    &mt UNDER INT2  &kp KP_NUMBER_0                   &kp PERIOD       &kp PLUS         &kp KP_NUMLOCK
            >;

            sensor-bindings = <&mouse_scrl SCRL_DOWN SCRL_UP>;
        };

        COUSOR {
            bindings = <
&bt BT_CLR    &kp F2          &kp F3  &kp F4  &kp F5                          &kp LC(HOME)  &kp HOME       &kp UP    &kp END      &kp DEL
&bt BT_SEL 0  &none           &none   &MPW    &none                           &kp LC(END)   &kp LEFT       &kp DOWN  &kp RIGHT    &kp ENTER
&bt BT_SEL 1  &none           &none   &none   &none                           &none         &kp PAGE_DOWN  &none     &kp PAGE_UP  &none
&bt BT_SEL 2  &studio_unlock  &none   &none   &none   &kp SPACE    &kp SPACE  &mo 1                        &none     &none        &kp ESCAPE
            >;

            sensor-bindings = <&mouse_scrl SCRL_DOWN SCRL_UP>;
        };

        MARK {
            bindings = <
&kp ESCAPE  &none  &kp GRAVE   &kp LS(NUMBER_2)  &kp LS(NUMBER_7)                      &none          &kp LS(NUMBER_6)  &none     &none             &kp BACKSPACE
&none       &none  &kp DOLLAR  &kp HASH          &kp PERCENT                           &kp INT_YEN    &kp SEMI          &kp APOS  &kp LEFT_BRACKET  &kp LS(MINUS)
&none       &none  &none       &none             &none                                 &kp BACKSLASH  &kp FSLH          &none     &none             &none
&none       &none  &none       &none             &none             &none    &kp GRAVE  &none                            &none     &none             &kp ESCAPE
            >;

            sensor-bindings = <&mouse_scrl SCRL_DOWN SCRL_UP>;
        };

        LAYER {
            bindings = <
&kp ESC  &none  &none  &none  &none                        &none  &none  &none  &none  &none
&none    &none  &none  &none  &none                        &none  &to 6  &none  &none  &none
&none    &none  &none  &none  &none                        &none  &none  &none  &none  &none
&none    &none  &none  &none  &none  &kp LGUI    &kp LGUI  &none         &none  &none  &none
            >;
        };

        WORK0101 {
            bindings = <
&to 0             &kp W  &kp E         &kp R  &none                                   &kp PAGE_UP    &MsetA    &kp UP_ARROW    &MsetB     &kp BACKSPACE
&kp A             &kp S  &none         &none  &msc SCRL_UP                            &kp PAGE_DOWN  &kp LEFT  &kp DOWN_ARROW  &kp RIGHT  &kp ENTER
&mt LEFT_SHIFT Z  &kp X  &kp C         &kp V  &msc SCRL_DOWN                          &to 7          &kp HOME  &mkp LCLK       &kp END    &none
&mt LCTRL TAB     &none  &kp LEFT_ALT  &none  &kp LEFT_GUI    &kp SPACE    &kp SPACE  &kp ENTER                &none           &none      &kp ESCAPE
            >;

            sensor-bindings = <&inc_dec_kp (LC(O)) LC(W)>;
        };

        WORK0102 {
            bindings = <
&to 0           &kp F2  &kp E         &kp R  &kp F5                                   &Msavetofav      &kp KP_NUMBER_7  &kp KP_NUMBER_8  &kp KP_NUMBER_9  &kp BACKSPACE
&kp TAB         &kp S   &none         &none  &msc SCRL_DOWN                           &Msavetonotfav   &kp KP_NUMBER_4  &kp KP_NUMBER_5  &kp KP_NUMBER_6  &mt MINUS ENTER
&kp LEFT_SHIFT  &kp X   &kp C         &kp V  &msc SCRL_DOWN                           &to 6            &kp KP_NUMBER_1  &kp KP_NUMBER_2  &kp KP_NUMBER_3  &Msave
&kp LCTRL       &none   &kp LEFT_ALT  &none  &kp LEFT_GUI    &kp PERIOD    &kp ENTER  &kp KP_NUMBER_0                   &kp PERIOD       &none            &kp ESCAPE
            >;

            sensor-bindings = <&inc_dec_kp LC(LG(RIGHT)) LC(LG(LEFT))>;
        };

        MOUSE {
            bindings = <
&to 0           &none         &none         &kp R  &kp F5                          &none  &none      &kp DELETE  &none  &kp BACKSPACE
&kp A           &kp S         &kp D         &none  &none                           &none  &mkp LCLK  &mkp RCLK   &none  &kp ENTER
&kp LEFT_SHIFT  &kp X         &kp C         &kp V  &none                           &none  &kp LC(C)  &kp LC(V)   &none  &none
&mt LCTRL TAB   &kp LEFT_GUI  &kp LEFT_ALT  &none  &mo 1   &kp SPACE    &kp SPACE  &mo 1             &none       &none  &kp ESCAPE
            >;

            sensor-bindings = <&mouse_scrl SCRL_DOWN SCRL_UP>;
        };

        MOUSE_VFAST {
            bindings = <
&to 0           &none         &none         &kp R  &kp F5                          &none  &none      &kp DELETE  &none  &kp BACKSPACE
&kp A           &kp S         &kp D         &none  &none                           &none  &mkp LCLK  &mkp RCLK   &none  &kp ENTER
&kp LEFT_SHIFT  &kp X         &kp C         &kp V  &none                           &none  &kp LC(C)  &kp LC(V)   &none  &none
&mt LCTRL TAB   &kp LEFT_GUI  &kp LEFT_ALT  &none  &mo 1   &kp SPACE    &kp SPACE  &mo 1             &none       &none  &kp ESCAPE
            >;

            sensor-bindings = <&mouse_scrl SCRL_DOWN SCRL_UP>;
        };

        MOUSE_SLOW {
            bindings = <
&to 0           &none         &none         &kp R  &kp F5                          &none  &none      &kp DELETE  &none  &kp BACKSPACE
&kp A           &kp S         &kp D         &none  &none                           &none  &mkp LCLK  &mkp RCLK   &none  &kp ENTER
&kp LEFT_SHIFT  &kp X         &kp C         &kp V  &none                           &none  &kp LC(C)  &kp LC(V)   &none  &none
&mt LCTRL TAB   &kp LEFT_GUI  &kp LEFT_ALT  &none  &mo 1   &kp SPACE    &kp SPACE  &mo 1             &none       &none  &kp ESCAPE
            >;

            sensor-bindings = <&mouse_scrl SCRL_DOWN SCRL_UP>;
        };

        WORK02 {
            bindings = <
&to 0           &kp Q         &kp UP_ARROW    &kp R      &kp T                                 &none  &none      &mkp LCLK  &mkp RCLK  &kp BACKSPACE
&kp LEFT        &kp LEFT      &kp UP_ARROW    &kp RIGHT  &kp RIGHT                             &none  &mkp LCLK  &mkp RCLK  &none      &kp ENTER
&kp LEFT_SHIFT  &kp DOWN      &kp DOWN_ARROW  &kp V      &kp B                                 &none  &none      &none      &none      &none
&kp LCTRL       &kp LEFT_GUI  &kp LEFT_ALT    &none      &kp NUMBER_2  &kp SPACE    &kp SPACE  &mo 1             &none      &none      &kp ESCAPE
            >;

            sensor-bindings = <&mouse_scrl SCRL_DOWN SCRL_UP>;
        };
    };
};
